{
  "expo": {
    "name": "מגיע לי",
    "slug": "magiali",
    "scheme": "magiali",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "il.co.magiali.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "il.co.magiali.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "מגיע לי",
      "shortName": "מגיע לי",
      "themeColor": "#0F766E",
      "backgroundColor": "#F8FAFC",
      "description": "צלמו קבלה רפואית וקבלו את ההחזר מהשב\"ן ומהביטוח"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "כדי לבחור קבלות רפואיות מהגלריה ולבקש עבורן החזר.",
          "cameraPermission": "כדי לצלם קבלות רפואיות ולבקש עבורן החזר.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      "@sentry/react-native/expo"
    ],
    "extra": {
      "router": {}
    }
  }
}
