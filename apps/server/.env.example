# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
ROLE=all
PORT=4000
DATABASE_URL=postgres://magiali:magiali@localhost:5432/magiali
PUBLIC_BASE_URL=http://localhost:4000
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-1234
OTP_PEPPER=change-me-otp-pepper-1234
# 32 random bytes, base64: openssl rand -base64 32
MASTER_KEY=
FILES_SIGNING_SECRET=change-me-files-signing-secret-123456789
ADMIN_TOKEN=change-me-admin-token-1234567890
